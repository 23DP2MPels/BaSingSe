
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid())
  email String @unique
  password String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile Profile?
}

model Profile {
  userId String @id
  avatar String
  name String
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}